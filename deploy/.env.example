# Public hostnames (point DNS at this server before starting).
API_HOST=api.staging.schuly.dev

# Image version. A fixed version means you decide when to move; `latest` follows every release.
SCHULY_VERSION=3.20.0

# Postgres.
POSTGRES_USER=schuly
POSTGRES_PASSWORD=change-me-postgres

# Sign-in keys (base64, exactly 32 bytes each). Generate with: openssl rand -base64 32
# Keep them stable: a new signing key signs everybody out, a new encryption key
# breaks every two-factor setup.
LOCAL_LOGIN_SIGNING_KEY=change-me-signing-key
TWO_FACTOR_ENCRYPTION_KEY=change-me-two-factor-key

# SeaweedFS S3 credentials - MUST match config/seaweedfs/s3-config.json.
S3_ACCESS_KEY=schuly-staging-access
S3_SECRET_KEY=change-me-s3-secret

# HMAC key for signing avatar URLs (any long random string).
# Generate one with: openssl rand -hex 32
AVATAR_SIGNING_KEY=change-me-avatar-signing-key

# Master key for encrypting student documents at rest (base64, 32 bytes).
# Generate one with: openssl rand -base64 32
# Losing or changing this key makes already-stored documents unreadable.
DOCUMENTS_ENCRYPTION_KEY=change-me-documents-encryption-key

# Master key for the plugin vault (base64, exactly 32 bytes). Encrypts the school
# credentials plugins store. Keep it stable - the backend cannot decrypt anything
# written under a different key. Generate one with: openssl rand -base64 32
VAULT_MASTER_KEY=change-me-vault-master-key

# Only while rotating VAULT_MASTER_KEY: the old key. See "Rotate the vault key" in docs/setup/operations.md.
#VAULT_PREVIOUS_MASTER_KEY=

# Mail server for email verification and password reset. Port 465 uses TLS,
# other ports require STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@schuly.example
SMTP_USER=schuly
SMTP_PASSWORD=change-me-smtp

# Firebase service account for push notifications. Optional - base64 of the
# service-account JSON; leave unset to run without push.
#FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared key between the backend's Microsoft plugin and the schulymicrosoft service
# (any long random string). Leave empty to turn off the web Microsoft password sign-in.
# Generate one with: openssl rand -hex 32
MICROSOFT_SERVICE_KEY=

# Helply's workspace sandbox (optional, needs /dev/kvm on the host). Uncomment all three to run the sidecar and let
# Helply use it. The key is shared by the backend and the sidecar only; at least 32 characters.
# Generate one with: openssl rand -hex 32
#COMPOSE_PROFILES=sandbox
#HELPLY_SANDBOX_URL=http://sandbox:8080
#SANDBOX_API_KEY=
